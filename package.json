  },
  "homepage": "https://cronradar.com/nodejs",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "src/constants.js",
    "README.md"
  ],
  "devDependencies": {
